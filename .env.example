# Where the site listens. This host's tailnet address (tailscale ip -4) keeps
# it off the rest of the LAN. Blank means all interfaces.
BIND_ADDR=

# Where the broker listens. NOT the tailnet address: the ESP32 is an ordinary
# LAN device and cannot join a tailnet, so the broker must be reachable at a
# LAN address. Blank means all interfaces; set this host's LAN IP to narrow it.
MQTT_BIND_ADDR=

MQTT_USERNAME=backend
MQTT_PASSWORD=

DEVICE_ID=printer-1
