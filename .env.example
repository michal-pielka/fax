MQTT_USERNAME=backend
MQTT_PASSWORD=

DEVICE_ID=printer-1

# Which images to run: a commit hash from the images workflow, or unset for
# latest. Set it to roll back: FAX_TAG=<sha> ./deploy/update.sh
# FAX_TAG=

# IPs or CIDR ranges Caddy drops, space-separated. Apply with
# `docker compose up -d caddy`: Caddy reads it only at start.
# FAX_BANNED="203.0.113.9 198.51.100.0/24"
