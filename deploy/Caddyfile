{
	# rate_limit is a plugin (deploy/caddy/Dockerfile), so Caddy has no
	# built-in place for it among the other handlers.
	order rate_limit before basic_auth
}

fax.pielka.sh {
	encode gzip

	# The edge sees what no service does: static files, the broker websocket,
	# and anything refused before it reaches the gateway.
	log {
		output stdout
		format json
	}

	# FAX_BANNED from .env: space-separated IPs or CIDR ranges. Their
	# connections are closed with no response. Empty bans nobody.
	@banned remote_ip {$FAX_BANNED}
	handle @banned {
		abort
	}

	# Three prints per ten minutes per address, refused prints included.
	# Everything else, the page and the wall, is never limited.
	rate_limit {
		zone prints {
			match {
				method POST
				path /api/print
			}
			key {client_ip}
			events 3
			window 10m
		}
	}

	# The page shows a refusal's "error" field, so say it in its words.
	handle_errors 429 {
		header Content-Type application/json
		respond `{"error":"too many prints, try again in a few minutes"}` 429
	}

	handle /mqtt* {
		reverse_proxy mosquitto:9001
	}

	handle /api/* {
		reverse_proxy gateway:8080
	}

	handle {
		root * /srv/web
		# Clean page URLs: /prints serves prints.html.
		try_files {path} {path}.html
		file_server
	}
}
