fax.pielka.sh {
	encode gzip

	# The edge sees requests no service does: static files, the broker
	# websocket, and anything refused before it reaches the gateway. Without
	# this those are simply invisible.
	#
	# stdout so it lands in the same `docker compose logs` as everything else,
	# and under the same rotation.
	log {
		output stdout
		format json
	}

	handle /mqtt* {
		reverse_proxy mosquitto:9001
	}

	handle /api/* {
		reverse_proxy gateway:8080
	}

	handle {
		root * /srv/web
		file_server
	}
}
